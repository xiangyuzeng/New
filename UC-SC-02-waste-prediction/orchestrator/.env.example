# UC-SC-02: Waste Prediction & Reduction — Environment Variables
# Copy to .env and fill in actual credentials

# ─── Source Database Servers ─────────────────────────────────────────────────
# scm-shopstock (stock changes, transfers)
SCM_SHOPSTOCK_HOST=aws-luckyus-scm-shopstock-rw
SCM_SHOPSTOCK_PORT=3306
SCM_SHOPSTOCK_USER=
SCM_SHOPSTOCK_PASSWORD=
SCM_SHOPSTOCK_DB=scm_shopstock

# opqualitycontrol (expiry, disposal, shelf-life)
OPQC_HOST=aws-luckyus-opqualitycontrol-rw
OPQC_PORT=3306
OPQC_USER=
OPQC_PASSWORD=
OPQC_DB=opqualitycontrol

# opproduction (production, remakes)
OPPROD_HOST=aws-luckyus-opproduction-rw
OPPROD_PORT=3306
OPPROD_USER=
OPPROD_PASSWORD=
OPPROD_DB=opproduction

# ireplenishment (demand forecasts)
IREP_HOST=aws-luckyus-ireplenishment-rw
IREP_PORT=3306
IREP_USER=
IREP_PASSWORD=
IREP_DB=ireplenishment

# pub-dm (product master)
PUBDM_HOST=aws-luckyus-pubdm-rw
PUBDM_PORT=3306
PUBDM_USER=
PUBDM_PASSWORD=
PUBDM_DB=pubdm

# opshop (store master)
OPSHOP_HOST=aws-luckyus-opshop-rw
OPSHOP_PORT=3306
OPSHOP_USER=
OPSHOP_PASSWORD=
OPSHOP_DB=opshop

# scm-commodity (BOM/recipes)
SCMCOMM_HOST=aws-luckyus-scmcommodity-rw
SCMCOMM_PORT=3306
SCMCOMM_USER=
SCMCOMM_PASSWORD=
SCMCOMM_DB=scmcommodity

# sales-order (sales transactions)
SALESORDER_HOST=aws-luckyus-salesorder-rw
SALESORDER_PORT=3306
SALESORDER_USER=
SALESORDER_PASSWORD=
SALESORDER_DB=salesorder

# ─── Analytics (Target) Database ─────────────────────────────────────────────
ANALYTICS_HOST=aws-luckyus-dbatest-rw
ANALYTICS_PORT=3306
ANALYTICS_USER=
ANALYTICS_PASSWORD=
ANALYTICS_DB=test

# ─── Pipeline Settings ───────────────────────────────────────────────────────
PIPELINE_LOG_LEVEL=INFO
PIPELINE_TIMEOUT_SECONDS=3600
SP_TIMEOUT_SECONDS=600
DEFAULT_BATCH_SIZE=10000
